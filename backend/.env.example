PORT=3000
NODE_ENV=development

# Supabase — find these in your Supabase project settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# A random secret used to authenticate internal cron endpoints
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_CRON_SECRET=your-cron-secret

# ── Schema additions required before these features work ──────────────────────
# profiles table: expo_push_token TEXT, subscription_tier TEXT,
#                 subscription_status TEXT, subscription_expires_at TIMESTAMPTZ,
#                 has_seen_primer BOOLEAN DEFAULT false
# goals table:    safe_mode BOOLEAN DEFAULT false
# crews table:    health_score INT DEFAULT 0
# new tables:     notification_prefs, sprint_votes, encouragements, badges
# V1.1 tables:    crew_streaks, public_groups, public_group_members
